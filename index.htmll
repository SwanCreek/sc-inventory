<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#28392F">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="SC Count">
<title>Swan Creek Inventory Count</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Raleway:wght@500;600;700;800&display=swap">
<style>
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0}
[hidden]{display:none!important}

/* Layout: one-column phone app, one task per screen, sticky top bar, big thumb-sized controls */
:root{
  --bg:#EFEAE1; --surface:#FBF8F3; --line:#D8D2C6; --fg:#28392F; --muted:#5C6E62;
  --primary:#28392F; --on-primary:#EFEAE1; --accent:#9A7A45; --gold:#C8A85E; --gold-tint:#F1E4C3;
  --ok:#2F6B45; --ok-tint:#DCEBDF; --warn:#9A5B12; --warn-tint:#F6E3C8; --bad:#9B2C2C; --bad-tint:#F5D9D6;
  --display:"Libre Baskerville",Georgia,serif; --body:"Raleway","Helvetica Neue",Helvetica,Arial,sans-serif;
  --r:14px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#131A16; --surface:#1F2A24; --line:#33433A; --fg:#EFEAE1;
  --muted:#B5AEA2; --primary:#C8A85E; --on-primary:#131A16; --accent:#C8A85E; --gold:#C8A85E; --gold-tint:#3A3221;
  --ok:#7CC394; --ok-tint:#1E3527; --warn:#E3A857; --warn-tint:#3B2C18; --bad:#EE8B84; --bad-tint:#3E2220; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#131A16; --surface:#1F2A24; --line:#33433A; --fg:#EFEAE1;
  --muted:#B5AEA2; --primary:#C8A85E; --on-primary:#131A16; --accent:#C8A85E; --gold:#C8A85E; --gold-tint:#3A3221;
  --ok:#7CC394; --ok-tint:#1E3527; --warn:#E3A857; --warn-tint:#3B2C18; --bad:#EE8B84; --bad-tint:#3E2220; color-scheme:dark}
*{box-sizing:border-box}
html,body{min-height:100%}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:18px;line-height:1.45;font-weight:500;
  font-variant-numeric:lining-nums tabular-nums;-webkit-text-size-adjust:100%}
button,input,select,textarea{font:inherit;color:inherit;font-variant-numeric:lining-nums tabular-nums}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
#app{max-width:640px;margin:0 auto;padding:0 16px 120px}
h1,h2{font-family:var(--display);font-weight:700;text-wrap:balance;margin:0;letter-spacing:-.01em}
h1{font-size:1.6rem;line-height:1.2}
h2{font-size:1.2rem;line-height:1.3}
.label{font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.muted{color:var(--muted)}
.small{font-size:.88rem}
.stack{display:flex;flex-direction:column;gap:12px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.grow{flex:1;min-width:0}

/* top bar */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);display:flex;align-items:center;gap:10px;
  padding:12px 0;border-bottom:1px solid var(--line);margin-bottom:18px}
.bar .t{flex:1;min-width:0;font-weight:700;font-size:1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.back{min-height:48px;padding:0 16px 0 10px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);
  font-weight:700;display:inline-flex;align-items:center;gap:6px}
.back svg{width:22px;height:22px}
.who-chip{font-size:.85rem;font-weight:700;padding:8px 12px;border-radius:999px;background:var(--surface);border:1px solid var(--line)}

/* buttons */
.btn{min-height:60px;border-radius:var(--r);border:0;padding:0 20px;font-weight:800;font-size:1.1rem;display:flex;
  align-items:center;justify-content:center;gap:10px;width:100%;text-align:center}
.btn.primary{background:var(--primary);color:var(--on-primary)}
.btn.ok{background:var(--ok);color:var(--bg)}
.btn.ghost{background:var(--surface);border:1.5px solid var(--line)}
.btn.danger{background:var(--bad-tint);color:var(--bad)}
.btn.small{min-height:48px;font-size:1rem;width:auto;padding:0 16px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.big{min-height:72px;font-size:1.25rem}

/* card-ish surfaces */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px}

/* sign in */
.brand{padding:34px 0 22px;display:flex;flex-direction:column;gap:6px}
.brand .mark{font-family:var(--display);font-size:2rem;line-height:1.1}
.brand .mark em{font-style:italic;color:var(--accent)}
.names{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.name{min-height:72px;border-radius:var(--r);border:1.5px solid var(--line);background:var(--surface);font-weight:700;
  font-size:1.05rem;padding:8px 12px;text-align:left;display:flex;align-items:center;gap:12px;min-width:0}
.name .av{flex:none;width:40px;height:40px;border-radius:50%;background:var(--gold-tint);color:var(--fg);display:grid;place-items:center;
  font-weight:800;font-size:.9rem}
.name span:last-child{min-width:0;overflow-wrap:anywhere}

/* pin pad */
.dots{display:flex;gap:18px;justify-content:center;margin:20px 0 8px}
.dot{width:22px;height:22px;border-radius:50%;border:2.5px solid var(--fg)}
.dot.on{background:var(--fg)}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:360px;margin:16px auto 0}
.key{min-height:74px;border-radius:18px;background:var(--surface);border:1.5px solid var(--line);font-size:1.7rem;font-weight:700}
.key.alt{font-size:1rem;background:transparent;border-color:transparent}
.shake{animation:sh .35s}
@keyframes sh{20%,60%{transform:translateX(-10px)}40%,80%{transform:translateX(10px)}}
@media (prefers-reduced-motion:reduce){.shake{animation:none}}
.msg{text-align:center;min-height:1.5em;font-weight:700}
.msg.bad{color:var(--bad)}

/* home tiles */
.month{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:6px}
.tiles{display:grid;grid-template-columns:1fr;gap:10px}
.tile{display:grid;grid-template-columns:48px 1fr auto;align-items:center;gap:14px;min-height:84px;padding:12px 16px;border-radius:var(--r);
  background:var(--surface);border:1.5px solid var(--line);text-align:left;width:100%}
.tile .ic{width:48px;height:48px;border-radius:12px;background:var(--gold-tint);display:grid;place-items:center}
.tile .ic svg{width:28px;height:28px;stroke:var(--fg);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.tile .nm{font-weight:800;font-size:1.08rem;line-height:1.25}
.tile .pg{font-size:.85rem;color:var(--muted);margin-top:2px}
.meter{height:6px;border-radius:3px;background:var(--line);overflow:hidden;margin-top:8px}
.meter i{display:block;height:100%;background:var(--ok);border-radius:3px}
.tile .chev{color:var(--muted)}
.tile.done{border-color:var(--ok)}

.search{position:relative}
.search input{width:100%;min-height:58px;border-radius:var(--r);border:1.5px solid var(--line);background:var(--surface);padding:0 16px 0 50px;font-size:1.05rem}
.search svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);width:22px;height:22px;stroke:var(--muted);fill:none;stroke-width:2}

/* item list */
.list{display:flex;flex-direction:column;border-radius:var(--r);overflow:hidden;border:1px solid var(--line);background:var(--surface)}
.it{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:14px 16px;min-height:72px;border:0;border-top:1px solid var(--line);
  background:transparent;text-align:left;width:100%}
.it:first-child{border-top:0}
.it .n{font-weight:700;line-height:1.3;overflow-wrap:anywhere}
.it .m{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;align-items:center}
.code{font-size:.8rem;color:var(--muted);font-weight:600}
.unit{display:inline-flex;align-items:center;gap:6px;font-size:.78rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
  padding:4px 9px;border-radius:999px;background:var(--gold-tint);color:var(--fg)}
.st{font-size:.85rem;font-weight:800;padding:6px 10px;border-radius:999px;white-space:nowrap}
.st.done{background:var(--ok-tint);color:var(--ok)}
.st.todo{background:transparent;color:var(--muted);border:1.5px dashed var(--line)}
.sub-h{padding:10px 16px;background:var(--bg);border-top:1px solid var(--line)}
.sub-h:first-child{border-top:0}

/* item screen */
.howto{border-radius:var(--r);background:var(--gold-tint);padding:16px;display:flex;flex-direction:column;gap:10px}
.howto .big{font-size:1.15rem;font-weight:800;line-height:1.3}
.howto ul{margin:0;padding-left:1.1em;display:flex;flex-direction:column;gap:6px}
.lastc{display:flex;flex-direction:column;gap:2px;padding:10px 12px;border-radius:10px;background:var(--surface)}
.lastc b{font-size:1.15rem}
.unit-hero{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.unit-hero b{font-family:var(--display);font-size:1.5rem}
.field{display:flex;flex-direction:column;gap:8px}
.field > label{font-weight:800;font-size:1.05rem}
.stepper{display:grid;grid-template-columns:72px 1fr 72px;gap:10px}
.stepper button{min-height:72px;border-radius:var(--r);border:1.5px solid var(--line);background:var(--surface);font-size:2rem;font-weight:700}
.stepper input{min-height:72px;border-radius:var(--r);border:2px solid var(--fg);background:var(--surface);text-align:center;font-size:2rem;font-weight:800;width:100%;min-width:0}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{min-height:56px;min-width:64px;padding:0 16px;border-radius:12px;border:1.5px solid var(--line);background:var(--surface);font-weight:800;font-size:1.1rem}
.chip.on{background:var(--primary);color:var(--on-primary);border-color:var(--primary)}
.pills{display:flex;flex-wrap:wrap;gap:8px}
.pill{display:inline-flex;align-items:center;gap:8px;padding:8px 8px 8px 14px;border-radius:999px;background:var(--surface);border:1.5px solid var(--line);font-weight:700}
.pill button{width:32px;height:32px;border-radius:50%;border:0;background:var(--bad-tint);color:var(--bad);font-weight:800}
.total{position:sticky;bottom:0;z-index:4;background:var(--bg);padding:12px 0 calc(12px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
.total .sum{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.total .sum b{font-family:var(--display);font-size:1.7rem}
.rows{display:flex;flex-direction:column;gap:8px}
.brow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;background:var(--surface);border:1px solid var(--line);font-weight:700}
.brow button{min-height:40px;padding:0 12px;border-radius:10px;border:0;background:var(--bad-tint);color:var(--bad);font-weight:800}
.mini{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
.mini input,.inp{min-height:58px;border-radius:12px;border:1.5px solid var(--line);background:var(--surface);padding:0 14px;font-size:1.2rem;font-weight:700;width:100%;min-width:0}
textarea.inp{min-height:110px;padding:12px 14px;font-size:1rem;font-weight:500;line-height:1.4}
select.inp{font-size:1rem}
.prior{border-radius:var(--r);border:1.5px solid var(--accent);padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.toggle{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.choose{display:grid;gap:10px}

/* toast */
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ok);color:var(--bg);
  font-weight:800;padding:16px 22px;border-radius:999px;z-index:20;max-width:calc(100% - 32px);text-align:center;box-shadow:0 8px 30px rgb(0 0 0 / .25)}
.toast.bad{background:var(--bad)}

/* manager */
.tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px;scrollbar-width:none}
.tab{flex:none;min-height:46px;padding:0 14px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);font-weight:700;font-size:.95rem}
.tab.on{background:var(--primary);color:var(--on-primary);border-color:var(--primary)}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.kpi{padding:12px;border-radius:12px;background:var(--surface);border:1px solid var(--line)}
.kpi b{display:block;font-family:var(--display);font-size:1.4rem}
.log{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);overflow:hidden}
.lg{padding:12px 14px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:4px;font-size:.95rem;text-align:left;background:transparent;border-left:0;border-right:0;border-bottom:0;width:100%}
.lg:first-child{border-top:0}
.lg .top{display:flex;justify-content:space-between;gap:10px;font-weight:700}
.lg .top span:first-child{min-width:0;overflow-wrap:anywhere}
.lg.void .q{text-decoration:line-through;color:var(--muted)}
.flag{font-size:.75rem;font-weight:800;padding:3px 8px;border-radius:999px;text-transform:uppercase;letter-spacing:.04em}
.flag.warn{background:var(--warn-tint);color:var(--warn)}
.flag.bad{background:var(--bad-tint);color:var(--bad)}
.flag.ok{background:var(--ok-tint);color:var(--ok)}
.trail{font-size:.82rem;color:var(--muted)}
.hr{height:1px;background:var(--line);margin:6px 0}
.check{display:flex;gap:12px;align-items:flex-start;font-weight:600}
.check input{width:26px;height:26px;flex:none;margin-top:2px;accent-color:var(--ok)}
.empty{padding:28px 16px;text-align:center;color:var(--muted)}
.progress{height:10px;border-radius:5px;background:var(--line);overflow:hidden}
.progress i{display:block;height:100%;background:var(--ok)}

.demo-banner{margin:10px 0 0;padding:8px 12px;border-radius:10px;background:var(--gold-tint);font-size:.85rem;font-weight:700;text-align:center}
.demo-banner.bad{background:var(--bad-tint);color:var(--bad)}

</style>
</head>
<body>
<div id="app">
  <div class="brand">
    <div class="label">Swan Creek Cabinet Co.</div>
    <div class="mark">Monthly <em>Inventory</em> Count</div>
    <p class="muted">Loading…</p>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
<script>
"use strict";
/* ---------- the one setting you fill in (see SETUP.md) ---------- */
const CONFIG={
  scriptUrl:'https://script.google.com/macros/s/AKfycbx4cz6lBtfNxvmpitXEIyQd9YK9lLYceHFZ_g_Z9zQNblTwldPZeiARzeYtiZBcXcQf/exec'   // Apps Script web app URL, ends in /exec
};
const DEMO=!CONFIG.scriptUrl;

/* ---------- constants ---------- */
const AREAS=[
 {k:'sheet',name:'Sheet Goods',ic:'<path d="M4 8l8-4 8 4-8 4z"/><path d="M4 12l8 4 8-4"/><path d="M4 16l8 4 8-4"/>',
  guide:['Count full sheets by counting the edges on the side of the stack.','For cut-down pieces, tap about how much of a full sheet each one is.','Pieces smaller than about 2 ft × 2 ft are scrap. Skip them.','Check the label: thickness, species and core must match the item on screen.']},
 {k:'hardwood',name:'Hardwood Lumber',ic:'<rect x="3" y="6" width="18" height="4" rx="1"/><rect x="3" y="14" width="18" height="4" rx="1"/><path d="M7 8h2M13 16h3"/>',
  guide:['Lumber is counted in board feet. You measure, the app does the math.','Group boards that are the same thickness, width and length, then add them as one line.','Thickness: 4/4 is about 1 inch, 5/4 about 1¼ inch, 8/4 about 2 inches.','Measure width in inches and length in feet. Round down.']},
 {k:'millwork',name:'Millwork & Moulding',ic:'<path d="M3 18h18"/><path d="M5 18V9c0-2 1-3 3-3h11v3h-8c-1 0-2 1-2 2v7"/>',
  guide:['Moulding is counted in linear feet (LF).','Group sticks that are the same length. Tap the length, then enter how many sticks.','Make sure the profile and wood species match the item on screen.']},
 {k:'edge',name:'Edgebanding',ic:'<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
  guide:['Count full, sealed rolls.','For an open roll, tap about how much is left on it.','Check the color name and width on the roll label.']},
 {k:'hardware',name:'Hinges, Slides & Hardware',ic:'<rect x="5" y="3" width="6" height="18" rx="1"/><rect x="13" y="3" width="6" height="18" rx="1"/><circle cx="8" cy="8" r="1"/><circle cx="16" cy="8" r="1"/><circle cx="8" cy="16" r="1"/><circle cx="16" cy="16" r="1"/>',
  guide:['Look at the unit in the gold tag before you count. It changes item to item.','Drawer slides are usually counted in PAIRS or SETS, never single runners.','Hinges are counted each, unless the tag says box.']},
 {k:'accessories',name:'Accessories',ic:'<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M4 13h16M9 9V5h6v4"/>',
  guide:['Count each item.','Check size and finish against the item name.']},
 {k:'finishing',name:'Finishing Room',ic:'<path d="M7 3h10v3H7z"/><path d="M6 6h12v15H6z"/><path d="M9 11h6"/>',
  guide:['Count full, sealed containers first.','For an open can, lift or tip it to judge how full it is, then tap ¼, ½ or ¾.','Do not open sealed cans to check.','Gallon, 5-gallon pail and quart are different items. Match the size.']},
 {k:'supplies',name:'Shop Supplies & Fasteners',ic:'<path d="M12 3v12"/><path d="M8 7h8"/><path d="M10 15l2 6 2-6"/>',
  guide:['Count full, sealed boxes first.','Then count the open box: loose pieces, or tap how full it is.','The gold tag tells you how many come in a box.']},
 {k:'other',name:'Other & New Items',ic:'<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>',guide:['Count in the unit shown in the gold tag.']}
];
const AREA=Object.fromEntries(AREAS.map(a=>[a.k,a]));
const FR={0.25:'¼',0.5:'½',0.75:'¾'};


/* ---------- state ---------- */
const S={ready:false,me:null,token:null,people:[],materials:{},months:{},guides:{},settings:{facility:'Home Location',warehouse:'Swan Creek Cabinetry',bin:'Bin'},
  entries:{},notes:{},entMonth:null,view:'who',pick:null,pin:'',pin1:null,pinMsg:'',area:null,showAll:false,q:'',sku:null,draft:null,mode:'new',editId:null,tab:'progress',person:'',
  rMonth:null,rEntries:null,busy:'',mgrSku:null,editEntry:null,zeroes:false,impMsg:'',offline:false};
const $=s=>document.querySelector(s);
const app=$('#app');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nowISO=()=>new Date().toISOString();
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const uid=p=>p+Date.now().toString(36)+Math.random().toString(36).slice(2,8);
const monthKey=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
const monthName=k=>{if(!k)return'';const[y,m]=k.split('-');return new Date(+y,+m-1,1).toLocaleString('en-US',{month:'long',year:'numeric'})};
const tm=iso=>{const d=new Date(iso);return d.toLocaleDateString('en-US',{month:'short',day:'numeric'})+' '+d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})};
const r5=n=>Math.round(n*100000)/100000;
const fmt=n=>{n=r5(+n||0);const w=Math.floor(n),f=r5(n-w);if(FR[f])return(w?w+' ':'')+FR[f];return String(+n.toFixed(3))};
const initials=n=>String(n||'?').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();
const ICON_BACK='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>';
const ICON_SEARCH='<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>';
function splitName(n){const m=String(n||'').match(/^\s*(\d+)\s*-\s*(.*)$/);return m?{code:'#'+m[1],name:m[2].trim()}:{code:'',name:String(n||'').trim()}}
const meName=()=>S.me?.name||'';
const isMgr=()=>S.me?.role==='manager';
const LS={get(k,d){try{const v=localStorage.getItem(k);return v==null?d:JSON.parse(v)}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}},del(k){try{localStorage.removeItem(k)}catch(e){}}};

/* ---------- counting methods ---------- */
function methodOf(it){
  const u=String(it.uom||'EA').trim();
  let m;
  if(/^pair$/i.test(u))return{k:'pair',unit:'pairs',one:'pair',u};
  if(/^set$/i.test(u))return{k:'set',unit:'sets',one:'set',u};
  if((m=u.match(/^box of\s*([\d,]+)/i))){const n=+m[1].replace(/,/g,'');return{k:'box',n,unit:'boxes',one:'box',u}}
  if(/^\d+'\s*x\s*\d+'$/i.test(u))return{k:'sheet',unit:'sheets',one:'sheet',u};
  if(/board\s*feet|^bf$/i.test(u))return{k:'bf',unit:'board feet',one:'board foot',u};
  if(/^lf$|linear/i.test(u))return{k:'lf',unit:'linear feet',one:'linear foot',u};
  if(/5 gallon/i.test(u))return{k:'cont',unit:'5-gal pails',one:'5-gal pail',u};
  if(/gallon/i.test(u))return{k:'cont',unit:'gallons',one:'gallon',u};
  if(/quart/i.test(u))return{k:'cont',unit:'quarts',one:'quart',u};
  if((m=u.match(/^(\d+)'$/))){const ft=+m[1];return ft>=100?{k:'roll',ft,unit:'rolls',one:'roll',u}:{k:'each',unit:u+' pieces',one:u+' piece',u}}
  return{k:'each',unit:/^ea$/i.test(u)?'each':u,one:/^ea$/i.test(u)?'each':u,u};
}
function methodTips(M,it){
  switch(M.k){
    case'each':return{big:'Count every single one.',tips:['Enter one number: how many you see.']};
    case'pair':return{big:'Count in PAIRS. 1 pair = 2 pieces (left + right).',tips:['If you counted single pieces, use “I counted pieces” and the app divides by 2.']};
    case'set':return{big:'Count in SETS. One set = one complete package.',tips:['A set of drawer slides is both runners plus the hardware. Do not count single runners as a set.']};
    case'box':return{big:'Counted in BOXES of '+M.n.toLocaleString()+'.',tips:['Count full, sealed boxes.',M.n<=200?'For the open box, count the loose pieces. The app turns them into part of a box.':'For the open box, tap about how full it is.']};
    case'sheet':return{big:'Counted in full '+M.u.replace(/'/g,' ft').replace('x',' × ')+' sheets.',tips:['Count full sheets.','Tap ¼, ½ or ¾ for each cut-down piece.']};
    case'bf':return{big:'Counted in BOARD FEET. Measure, the app does the math.',tips:['Thickness × width (in) × length (ft) ÷ 12 = board feet.']};
    case'lf':return{big:'Counted in LINEAR FEET.',tips:['Tap a stick length, enter how many sticks, then Add.']};
    case'cont':return{big:'Counted in '+M.unit.toUpperCase()+'.',tips:['Count full, sealed containers.','For an open one, tap about how full it is.']};
    case'roll':return{big:'Counted in ROLLS of '+M.ft+' ft.',tips:['Count full rolls.','For an open roll, tap about how much is left.']};
  }
}
function newDraft(it,M){
  const d={full:'',parts:[],loose:'',rows:[],direct:'',mode:'build',piecesMode:false};
  if(M.k==='bf'){const t=String(it.name).match(/(\d{1,2})\/4/);d.t=t?+t[1]:4;d.w='';d.l='';d.c=''}
  if(M.k==='lf'){d.l=8;d.c='';d.extra=''}
  return d;
}
const num=v=>{const n=parseFloat(String(v).replace(',','.'));return isFinite(n)&&n>0?n:0};
function compute(M,d){
  let q=0,parts=[];
  if(M.k==='each'||M.k==='set'){q=num(d.full);parts.push(fmt(q)+' '+M.unit)}
  else if(M.k==='pair'){if(d.piecesMode){const p=num(d.loose);q=p/2;parts.push(p+' pieces ÷ 2')}else{q=num(d.full);parts.push(fmt(q)+' pairs')}}
  else if(M.k==='box'){const f=num(d.full);q=f;parts.push(f+' full box'+(f===1?'':'es'));
    if(M.n<=200){const l=num(d.loose);if(l){q+=l/M.n;parts.push(l+' loose pcs')}}
    else d.parts.forEach(p=>{q+=p;parts.push(FR[p]+' box')})}
  else if(M.k==='sheet'||M.k==='cont'||M.k==='roll'){const f=num(d.full);q=f;parts.push(f+' full');d.parts.forEach(p=>{q+=p;parts.push(FR[p])})}
  else if(M.k==='bf'){if(d.mode==='direct'){q=num(d.direct);parts.push(fmt(q)+' BF typed in')}
    else d.rows.forEach(r=>{const b=r.t/4*r.w*r.l/12*r.c;q+=b;parts.push(`${r.c} @ ${r.t}/4 × ${r.w}" × ${r.l}'`)})}
  else if(M.k==='lf'){d.rows.forEach(r=>{q+=r.l*r.c;parts.push(`${r.c} × ${r.l}'`)});const e=num(d.extra);if(e){q+=e;parts.push(e+"' short pcs")}}
  return{qty:r5(q),detail:parts.join(' + ')};
}

/* ---------- derived ---------- */
function liveEntries(src){return Object.values(src||S.entries).filter(e=>!e.voided)}
function totals(src){const t={};for(const e of liveEntries(src)){(t[e.sku]=t[e.sku]||{q:0,n:0,by:new Set()});t[e.sku].q=r5(t[e.sku].q+(+e.qty||0));t[e.sku].n++;t[e.sku].by.add(e.byName)}return t}
function areaItems(k){return Object.values(S.materials).filter(m=>m.active!==false&&(m.area||'other')===k)}
function openMonth(){const o=Object.entries(S.months).filter(([k,v])=>v.status==='open').sort((a,b)=>b[0].localeCompare(a[0]));return o[0]?.[0]||null}
function sortItems(list){return list.sort((a,b)=>(a.sub||'').localeCompare(b.sub||'')||splitName(a.name).name.localeCompare(splitName(b.name).name))}
function matches(m,q){if(!q)return true;const h=(m.name+' '+m.id+' '+(m.sub||'')).toLowerCase();return q.toLowerCase().split(/\s+/).every(w=>h.includes(w))}

/* ---------- toast ---------- */
let toastT;
function toast(t,bad){document.querySelector('.toast')?.remove();const d=document.createElement('div');d.className='toast'+(bad?' bad':'');d.setAttribute('role','status');d.textContent=t;document.body.appendChild(d);clearTimeout(toastT);toastT=setTimeout(()=>d.remove(),bad?5000:2200)}

/* ================= Backend: Google Apps Script web app over the Google Sheet ================= */
class NetErr extends Error{}
async function call(action,payload={}){
  const body=JSON.stringify({action,token:S.token,...payload});
  let res;
  if(DEMO){res=await window.demoServer(body)}
  else{
    let r;
    try{r=await fetch(CONFIG.scriptUrl,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body,redirect:'follow'})}
    catch(e){throw new NetErr('No connection')}
    if(!r.ok)throw new NetErr('Server '+r.status);
    try{res=await r.json()}catch(e){throw new NetErr('Bad response')}
  }
  if(!res.ok){const e=new Error(res.error||'Something went wrong');e.code=res.code;if(res.code==='auth'){signOut(true)}throw e}
  return res.data;
}

/* ---------- offline queue: every count is kept on the phone until the server confirms it ---------- */
let Q=LS.get('scQueue',[]);
const saveQ=()=>LS.set('scQueue',Q);
function enqueue(action,payload){Q.push({action,payload,qid:uid('q')});saveQ();pendingBadge();flush()}
let flushing=false;
async function flush(){
  if(flushing||!Q.length||!S.token)return;flushing=true;
  try{
    while(Q.length){
      const job=Q[0];
      try{const r=await call(job.action,job.payload);if(job.action==='addEntry'||job.action==='editEntry'){S.entries[r._id]=r}}
      catch(e){if(e instanceof NetErr){S.offline=true;break}
        console.warn('dropped',job,e);toast('One save was refused: '+e.message,true);if(job.action==='addEntry')delete S.entries[job.payload.entry.id]}
      Q.shift();saveQ();S.offline=false;
    }
  }finally{flushing=false;pendingBadge()}
}
function overlayQueue(){ // keep not-yet-sent counts visible after a refresh
  for(const j of Q){
    if(j.action==='addEntry'){const e=j.payload.entry;if(e.month===S.entMonth&&!S.entries[e.id])S.entries[e.id]={...e,_id:e.id,by:S.me?.id,byName:meName(),voided:false,edits:[],pending:true}}
    if(j.action==='editEntry'){const e=S.entries[j.payload.id];if(e){if(j.payload.type==='void')e.voided=true;else{e.qty=j.payload.qty;e.detail=j.payload.detail}e.pending=true}}
  }
}
function pendingBadge(){const el=$('#pend');if(!el)return;el.hidden=!Q.length;el.textContent=Q.length?(S.offline?`No signal · ${Q.length} count${Q.length>1?'s':''} saved on this phone, will send automatically`:`Sending ${Q.length}…`):''}
addEventListener('online',()=>flush());
setInterval(()=>{if(Q.length)flush()},15000);

/* ---------- loading & refresh ---------- */
function applyBoot(d){
  S.me=d.me;S.materials={};d.materials.forEach(m=>{if(m.id)S.materials[m.id]=m});
  S.months={};d.months.forEach(m=>S.months[m.key]=m);
  S.guides=d.settings.guides||{};if(d.settings.location)S.settings={...S.settings,...d.settings.location};
  if(d.people)S.allPeople=d.people;
}
let polling=false;
async function refresh(){
  if(polling||!S.token)return;polling=true;
  try{const d=await call('refresh');S.months={};d.months.forEach(m=>S.months[m.key]=m);S.entMonth=d.month;
    S.entries={};d.entries.forEach(e=>S.entries[e._id]=e);S.notes={};d.notes.forEach(n=>S.notes[n._id]=n);overlayQueue();S.offline=false}
  catch(e){if(e instanceof NetErr)S.offline=true;else console.warn(e)}
  polling=false;softRender();pendingBadge();
}
async function boot(){
  const sess=LS.get('scSession',null);
  if(sess?.token){S.token=sess.token;S.me=sess.me;
    app.innerHTML=loadingHTML('Opening the count…');
    try{applyBoot(await call('boot'));LS.set('scSession',{token:S.token,me:S.me});LS.set('scCache',{materials:Object.values(S.materials),months:Object.values(S.months),settings:{guides:S.guides,location:S.settings}});
      await refresh();S.view='home';S.ready=true;render();flush();startPolling();return}
    catch(e){
      if(e instanceof NetErr){const c=LS.get('scCache',null);if(c){applyBoot({me:S.me,materials:c.materials,months:c.months,settings:c.settings});S.offline=true;S.entMonth=Object.values(S.months).find(m=>m.status==='open')?.key||null;overlayQueue();S.view='home';S.ready=true;render();startPolling();return}}
      if(!S.token){/* signed out */}else{fatal('Couldn’t open the count: '+e.message);return}
    }
  }
  await loadPeople();
}
async function loadPeople(){
  app.innerHTML=loadingHTML('Loading…');
  try{S.people=await call('people');LS.set('scPeople',S.people)}catch(e){S.people=LS.get('scPeople',[]);if(!S.people.length){fatal(e instanceof NetErr?'No connection. Get to Wi-Fi or cell signal and try again.':'Couldn’t load the crew list: '+e.message);return}}
  S.view='who';S.ready=true;render();
}
let pollT;
function startPolling(){clearInterval(pollT);pollT=setInterval(()=>{if(!document.hidden)refresh()},30000);document.addEventListener('visibilitychange',()=>{if(!document.hidden)refresh()})}
function signOut(expired){
  if(S.token&&!expired&&!DEMO)call('logout').catch(()=>{});
  S.token=null;S.me=null;LS.del('scSession');clearInterval(pollT);
  if(Q.length&&!expired)toast(Q.length+' unsent counts are kept on this phone and will send at next sign-in.',true);
  S.pick=null;S.pin='';S.pin1=null;S.pinMsg='';loadPeople();
}
function loadingHTML(t){return`<div class="brand"><div class="label">Swan Creek Cabinet Co.</div><div class="mark">Monthly <em>Inventory</em> Count</div><p class="muted">${esc(t)}</p></div>`}
function fatal(t){app.innerHTML=loadingHTML('')+`<div class="panel stack"><b>${esc(t)}</b><button class="btn ghost" onclick="location.reload()">Try again</button></div>`}

function softRender(){
  if(!S.ready)return;
  if(S.view==='item'){const el=$('#prior');if(el)el.outerHTML=priorHTML();return}
  if(document.activeElement&&/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName))return;
  if(['home','area','search','review'].includes(S.view)){const y=scrollY;render();scrollTo(0,y)}
}
function openMonth(){return S.entMonth&&S.months[S.entMonth]?.status==='open'?S.entMonth:(Object.values(S.months).filter(m=>m.status==='open').map(m=>m.key).sort().pop()||null)}

/* ---------- views ---------- */
function bar(title,backTo){
  return `<div class="bar">${backTo?`<button class="back" data-act="go" data-v="${backTo}">${ICON_BACK}Back</button>`:''}<div class="t">${esc(title)}</div>${S.me?`<span class="who-chip">${esc(meName().split(' ')[0])}</span>`:''}</div>`;
}
function vHome(){
  const m=openMonth();const t=totals();const mgr=isMgr();
  let body='';
  if(!m){
    body=`<div class="panel stack"><h2>No count is open right now.</h2><p class="muted" style="margin:0">${mgr?'Start this month’s count when the crew is ready.':'Ask your manager to start the count.'}</p>
    ${mgr?`<button class="btn primary big" data-act="startMonth">Start ${esc(monthName(monthKey(new Date())))} count</button>`:''}</div>`;
  }else{
    const tiles=AREAS.map(a=>{const items=areaItems(a.k);if(!items.length)return'';const st=items.filter(i=>i.stocked);const base=st.length?st:items;
      const done=base.filter(i=>t[i.id]).length;const pct=base.length?Math.round(done/base.length*100):0;
      return `<button class="tile${pct===100?' done':''}" data-act="area" data-k="${a.k}"><span class="ic"><svg viewBox="0 0 24 24">${a.ic}</svg></span>
      <span><span class="nm">${esc(a.name)}</span><span class="pg" style="display:block">${done} of ${base.length} counted</span><span class="meter"><i style="width:${pct}%"></i></span></span><span class="chev">${ICON_BACK.replace('M15 5l-7 7 7 7','M9 5l7 7-7 7')}</span></button>`}).join('');
    body=`<div class="month"><div><div class="label">Now counting</div><h1>${esc(monthName(m))}</h1></div></div>
    <div class="search"><span>${ICON_SEARCH}</span><input id="q" type="search" placeholder="Find an item by name" autocomplete="off" data-in="q" value="${esc(S.q)}"></div>
    <div class="label" style="margin-top:6px">Pick where you’re counting</div><div class="tiles">${tiles||'<div class="panel empty">No materials loaded yet.</div>'}</div>
    <button class="btn ghost" data-act="go" data-v="note">Found something not on the list? Tell the manager</button>`;
  }
  return `<div class="bar"><div class="t">Hi, ${esc(meName().split(' ')[0])}</div>${mgr?'<button class="btn small primary" data-act="go" data-v="review">Manager</button>':''}<button class="btn small ghost" data-act="signout">Sign out</button></div>
  <div class="stack">${body}</div>`;
}
function itemRow(m,t){
  const sn=splitName(m.name);const tt=t[m.id];const M=methodOf(m);
  return `<button class="it" data-act="item" data-sku="${esc(m.id)}"><span style="min-width:0"><span class="n">${esc(sn.name)}</span>
  <span class="m"><span class="unit">${esc(M.u==='EA'?'Each':M.u)}</span>${sn.code?`<span class="code">${esc(sn.code)}</span>`:''}<span class="code">Last count: ${esc(fmt(m.onHand||0))}</span></span></span>
  ${tt?`<span class="st done">✓ ${esc(fmt(tt.q))}</span>`:`<span class="st todo">Count</span>`}</button>`;
}
function groupedList(items,t){
  let html='',cur=null;
  for(const m of items){if((m.sub||'')!==cur){cur=m.sub||'';if(cur)html+=`<div class="sub-h label">${esc(cur)}</div>`}html+=itemRow(m,t)}
  return `<div class="list">${html}</div>`;
}
function vArea(){
  const a=AREA[S.area];const t=totals();const all=sortItems(areaItems(S.area));
  const st=all.filter(i=>i.stocked||t[i.id]);const rest=all.filter(i=>!(i.stocked||t[i.id]));
  const g=(S.guides[a.k])||a.guide;
  return `${bar(a.name,'home')}<div class="stack">
  <details class="howto" ${st.every(i=>!t[i.id])?'open':''}><summary class="big" style="cursor:pointer">How to count ${esc(a.name.toLowerCase())}</summary><ul>${g.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></details>
  ${st.length?groupedList(st,t):'<div class="panel empty">Nothing here is usually in stock. Use the list below if you find something.</div>'}
  ${rest.length?(S.showAll?`<div class="label">Not usually in stock</div>${groupedList(rest,t)}<button class="btn ghost" data-act="showAll">Hide these items</button>`
    :`<button class="btn ghost" data-act="showAll">Show ${rest.length} more items we don’t usually stock</button>`):''}</div>`;
}
function vSearch(){
  const t=totals();const res=sortItems(Object.values(S.materials).filter(m=>m.active!==false&&matches(m,S.q))).slice(0,60);
  return `${bar('Find an item','home')}<div class="stack"><div class="search"><span>${ICON_SEARCH}</span><input id="q2" type="search" placeholder="Type part of the name" autocomplete="off" data-in="q" value="${esc(S.q)}"></div>
  <div id="sres">${res.length?groupedList(res,t):'<div class="panel empty">No match. Try fewer words, or tell the manager it’s missing.</div>'}</div></div>`;
}
function priorHTML(){
  const it=S.materials[S.sku];if(!it)return'<div id="prior"></div>';
  const mine=liveEntries().filter(e=>e.sku===S.sku).sort((a,b)=>a.at.localeCompare(b.at));
  if(!mine.length||S.mode!=='new')return'<div id="prior"></div>';
  const M=methodOf(it);const sum=r5(mine.reduce((s,e)=>s+(+e.qty||0),0));
  return `<div id="prior" class="prior"><div class="label">Already counted this month</div>
  ${mine.map(e=>`<div class="row"><span class="grow"><b>${esc(fmt(e.qty))} ${esc(M.unit)}</b> by ${esc(e.byName)}<br><span class="small muted">${esc(tm(e.at))} · ${esc(e.detail||'')}</span></span>
  ${(e.by===S.me?.id||isMgr())?`<button class="btn small ghost" data-act="fix" data-id="${esc(e._id)}">Fix</button>`:''}</div>`).join('')}
  <div class="small"><b>Total so far: ${esc(fmt(sum))} ${esc(M.unit)}.</b> Only add more if you counted a <b>different spot</b> that nobody counted yet.</div></div>`;
}
function stepper(id,val,label,hint){
  return `<div class="field"><label for="${id}">${label}</label>${hint?`<div class="small muted">${hint}</div>`:''}<div class="stepper"><button data-act="step" data-f="${id}" data-d="-1" aria-label="minus one">−</button>
  <input id="${id}" data-f="${id}" inputmode="decimal" autocomplete="off" placeholder="0" value="${esc(val)}"><button data-act="step" data-f="${id}" data-d="1" aria-label="plus one">+</button></div></div>`;
}
function partsHTML(M,d,q){
  return `<div class="field"><label>${q}</label><div class="chips">${[0.25,0.5,0.75].map(p=>`<button class="chip" data-act="part" data-p="${p}">+ ${FR[p]}</button>`).join('')}</div>
  ${d.parts.length?`<div class="pills">${d.parts.map((p,i)=>`<span class="pill">${FR[p]} ${esc(M.one)}<button data-act="unpart" data-i="${i}" aria-label="remove">✕</button></span>`).join('')}</div>`:'<div class="small muted">None yet. Skip this if there are no open ones.</div>'}</div>`;
}
function entryHTML(M,d){
  switch(M.k){
    case'each':case'set':return stepper('full',d.full,M.unit==='each'?'How many?':`How many ${M.unit}?`);
    case'pair':return `<div class="toggle"><button class="chip ${!d.piecesMode?'on':''}" data-act="pmode" data-v="0">I counted pairs</button><button class="chip ${d.piecesMode?'on':''}" data-act="pmode" data-v="1">I counted pieces</button></div>
      ${d.piecesMode?stepper('loose',d.loose,'How many single pieces?','The app divides by 2 for you.'):stepper('full',d.full,'How many pairs?')}`;
    case'box':return stepper('full',d.full,'Full, sealed boxes')+(M.n<=200?stepper('loose',d.loose,'Loose pieces in the open box','A full box has '+M.n+'.'):partsHTML(M,d,'Open box: about how full?'));
    case'sheet':return stepper('full',d.full,'Full sheets')+partsHTML(M,d,'Cut-down pieces: tap one for each piece');
    case'cont':return stepper('full',d.full,'Full, sealed '+M.unit)+partsHTML(M,d,'Open containers: about how full?');
    case'roll':return stepper('full',d.full,'Full rolls')+partsHTML(M,d,'Open rolls: about how much is left?');
    case'bf':return `<div class="toggle"><button class="chip ${d.mode==='build'?'on':''}" data-act="bmode" data-v="build">Measure boards</button><button class="chip ${d.mode==='direct'?'on':''}" data-act="bmode" data-v="direct">I know the board feet</button></div>
      ${d.mode==='direct'?stepper('direct',d.direct,'Board feet'):`
      <div class="field"><label>Thickness</label><div class="chips">${[4,5,6,8,10,12].map(x=>`<button class="chip ${d.t===x?'on':''}" data-act="bt" data-v="${x}">${x}/4</button>`).join('')}</div></div>
      <div class="mini"><div class="field"><label for="w">Width (inches)</label><input id="w" class="inp" data-f="w" inputmode="decimal" value="${esc(d.w)}" placeholder="6"></div>
      <div class="field"><label for="l">Length (feet)</label><input id="l" class="inp" data-f="l" inputmode="decimal" value="${esc(d.l)}" placeholder="8"></div>
      <div class="field"><label for="c">How many boards</label><input id="c" class="inp" data-f="c" inputmode="numeric" value="${esc(d.c)}" placeholder="1"></div></div>
      <button class="btn ghost" data-act="addrow">Add these boards</button>
      ${d.rows.length?`<div class="rows">${d.rows.map((r,i)=>`<div class="brow"><span>${r.c} × ${r.t}/4 × ${r.w}" × ${r.l}' = ${fmt(r.t/4*r.w*r.l/12*r.c)} BF</span><button data-act="unrow" data-i="${i}">Remove</button></div>`).join('')}</div>`:''}`}`;
    case'lf':return `<div class="field"><label>Stick length</label><div class="chips">${[6,7,8,9,10,12,14,16].map(x=>`<button class="chip ${d.l===x?'on':''}" data-act="ll" data-v="${x}">${x} ft</button>`).join('')}</div></div>
      ${stepper('c',d.c,'How many '+d.l+' ft sticks?')}<button class="btn ghost" data-act="addlf">Add ${esc(d.l)} ft sticks</button>
      ${d.rows.length?`<div class="rows">${d.rows.map((r,i)=>`<div class="brow"><span>${r.c} sticks × ${r.l} ft = ${fmt(r.c*r.l)} LF</span><button data-act="unrow" data-i="${i}">Remove</button></div>`).join('')}</div>`:''}
      ${stepper('extra',d.extra,'Short pieces: total feet (optional)','Add up the leftover short pieces and type the feet.')}`;
  }
}
function vItem(){
  const it=S.materials[S.sku];if(!it){S.view='home';return vHome()}
  const M=methodOf(it);const T=methodTips(M,it);const sn=splitName(it.name);const a=AREA[it.area||'other'];
  if(!S.draft)S.draft=newDraft(it,M);
  const c=compute(M,S.draft);
  const extra=it.howTo?`<li><b>${esc(it.howTo)}</b></li>`:'';
  const editing=S.mode==='fix';
  return `${bar(a.name,S.q&&S.from==='search'?'search':'area')}<div class="stack">
  <div><h1 style="font-size:1.35rem">${esc(sn.name)}</h1><div class="row small muted" style="margin-top:6px">${sn.code?`<span>${esc(sn.code)}</span>·`:''}<span>${esc(it.id)}</span>${it.sub?`·<span>${esc(it.sub)}</span>`:''}</div></div>
  <div class="howto"><div class="unit-hero"><span class="label">Count in</span><b>${esc(M.unit)}</b></div><div class="big">${esc(T.big)}</div><div class="lastc"><span class="label">Last count</span><b>${esc(fmt(it.onHand||0))} ${esc(M.unit)}</b><span class="small">Count what’s really there. It’s fine if your number is different.</span></div><ul>${extra}${T.tips.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>
  ${editing?`<div class="prior"><b>Fixing your count from ${esc(tm(S.entries[S.editId]?.at||nowISO()))}</b><span class="small">Was ${esc(fmt(S.entries[S.editId]?.qty))} ${esc(M.unit)}. Enter the right number below.</span></div>`:priorHTML()}
  ${entryHTML(M,S.draft)}
  <button class="btn ghost" data-act="zero">None here. Save zero.</button>
  </div>
  <div class="total"><div class="sum"><span class="label">You’re saving</span><b id="tot">${esc(fmt(c.qty))} <span style="font-family:var(--body);font-size:1rem">${esc(M.unit)}</span></b></div>
  <div class="small muted" id="det">${esc(c.detail)}</div>
  <button class="btn ok big" data-act="save" id="savebtn" ${c.qty>0?'':'disabled'}>${editing?'Save the fix':'Save count'}</button></div>`;
}
function vNote(){
  return `${bar('Tell the manager','home')}<div class="stack"><p style="margin:0">Found something that isn’t in the app? Describe it and how many. The manager will add it.</p>
  <textarea id="note" class="inp" placeholder="Example: 3 sheets of 3/4 walnut plywood on the back rack, no label"></textarea>
  <button class="btn primary big" data-act="sendNote">Send to manager</button></div>`;
}

/* ---------- manager ---------- */
function vReview(){
  const months=Object.keys(S.months).sort().reverse();
  if(!S.rMonth)S.rMonth=openMonth()||months[0]||null;
  const m=S.rMonth;const src=(m===S.entMonth)?S.entries:(S.rEntries||{});
  if(m&&m!==S.entMonth&&!S.rEntries&&S.busy!=='loading')loadMonth(m);
  const tabs=[['progress','Progress'],['review','Check counts'],['missing','Not counted'],['log','Who did what'],['export','Export'],['admin','Setup']];
  const head=`${bar('Manager','home')}
  ${months.length?`<div class="field" style="margin-bottom:12px"><label for="rm" class="label">Month</label><select id="rm" class="inp" data-in="rm">${months.map(k=>`<option value="${k}" ${k===m?'selected':''}>${esc(monthName(k))} · ${esc(S.months[k].status==='open'?'Open':'Closed')}</option>`).join('')}</select></div>`:''}
  <div class="tabs">${tabs.map(([k,l])=>`<button class="tab ${S.tab===k?'on':''}" data-act="tab" data-v="${k}">${l}</button>`).join('')}</div>`;
  if(S.tab==='admin')return head+vAdmin();
  if(!m)return head+`<div class="panel stack"><h2>No counts yet.</h2><button class="btn primary big" data-act="startMonth">Start ${esc(monthName(monthKey(new Date())))} count</button></div>`;
  if(m!==S.entMonth&&!S.rEntries)return head+'<div class="panel empty">Loading that month…</div>';
  const t=totals(src);const ents=Object.values(src);
  const stocked=Object.values(S.materials).filter(i=>i.stocked&&i.active!==false);
  const counted=Object.keys(t).length;const stockedDone=stocked.filter(i=>t[i.id]).length;
  let body='';
  if(S.tab==='progress'){
    const ppl={};liveEntries(src).forEach(e=>{ppl[e.byName]=(ppl[e.byName]||0)+1});
    const notes=Object.values(m===S.entMonth?S.notes:{}).sort((a,b)=>b.at.localeCompare(a.at));
    body=`<div class="kpis"><div class="kpi"><span class="label">Stocked items</span><b>${stockedDone}/${stocked.length}</b></div><div class="kpi"><span class="label">Items counted</span><b>${counted}</b></div><div class="kpi"><span class="label">Entries</span><b>${liveEntries(src).length}</b></div></div>
    <div class="progress" style="margin:14px 0"><i style="width:${stocked.length?Math.round(stockedDone/stocked.length*100):0}%"></i></div>
    <div class="log">${AREAS.map(a=>{const it=areaItems(a.k).filter(i=>i.stocked);if(!it.length)return'';const d=it.filter(i=>t[i.id]).length;
      return `<div class="lg"><div class="top"><span>${esc(a.name)}</span><span>${d}/${it.length}</span></div><div class="meter"><i style="width:${Math.round(d/it.length*100)}%"></i></div></div>`}).join('')}</div>
    <h2 style="margin-top:18px">Counters</h2><div class="log">${Object.entries(ppl).sort((a,b)=>b[1]-a[1]).map(([n,c])=>`<div class="lg"><div class="top"><span>${esc(n)}</span><span>${c} entries</span></div></div>`).join('')||'<div class="empty">Nobody has counted yet.</div>'}</div>
    <h2 style="margin-top:18px">Notes from the floor</h2><div class="log">${notes.map(n=>`<div class="lg"><div class="top"><span>${esc(n.byName)}</span><span class="small muted">${esc(tm(n.at))}</span></div><div>${esc(n.text)}</div></div>`).join('')||'<div class="empty">No notes.</div>'}</div>
    ${S.months[m]?.status==='open'?`<button class="btn danger" style="margin-top:18px" data-act="closeMonth">Close the ${esc(monthName(m))} count</button>`:`<button class="btn ghost" style="margin-top:18px" data-act="reopenMonth">Reopen ${esc(monthName(m))}</button>`}`;
  }else if(S.tab==='review'){
    const rows=Object.entries(t).map(([sku,v])=>{const it=S.materials[sku]||{name:sku,onHand:0};const was=+it.onHand||0;const diff=r5(v.q-was);
      const pct=was?Math.abs(diff)/was:(v.q?1:0);return{sku,it,v,was,diff,pct,flag:!was&&v.q?'new':pct>=0.5?'bad':pct>=0.2?'warn':'ok'}})
      .filter(r=>r.flag!=='ok').sort((a,b)=>b.pct-a.pct);
    body=`<p class="muted small" style="margin-top:0">Counts that differ from Innergy by 20% or more, or items Innergy shows as out of stock. Tap one to see who counted it and fix it.</p>
    <div class="log">${rows.map(r=>`<button class="lg" data-act="mgritem" data-sku="${esc(r.sku)}"><div class="top"><span>${esc(splitName(r.it.name).name)}</span><span class="flag ${r.flag==='new'?'warn':r.flag}">${r.flag==='new'?'Not in Innergy':(r.diff>0?'+':'')+Math.round(r.pct*100)+'%'}</span></div>
      <div class="small muted">Counted <b>${esc(fmt(r.v.q))}</b> · Innergy ${esc(fmt(r.was))} · ${esc(r.it.uom)} · by ${esc([...r.v.by].join(', '))}</div></button>`).join('')||'<div class="empty">Nothing stands out. Counts are close to Innergy.</div>'}</div>`;
  }else if(S.tab==='missing'){
    const miss=sortItems(stocked.filter(i=>!t[i.id]));
    body=`<p class="muted small" style="margin-top:0">${miss.length} items Innergy says are in stock that nobody has counted yet.</p>
    ${AREAS.map(a=>{const l=miss.filter(i=>(i.area||'other')===a.k);return l.length?`<div class="label" style="margin:14px 0 6px">${esc(a.name)} · ${l.length}</div><div class="log">${l.map(i=>`<button class="lg" data-act="mgritem" data-sku="${esc(i.id)}"><div class="top"><span>${esc(splitName(i.name).name)}</span><span class="small muted">${esc(fmt(i.onHand))} ${esc(i.uom)}</span></div></button>`).join('')}</div>`:''}).join('')||'<div class="panel empty">Every stocked item has a count.</div>'}`;
  }else if(S.tab==='log'){
    const names=[...new Set(ents.map(e=>e.byName))].sort();
    const list=ents.filter(e=>!S.person||e.byName===S.person).sort((a,b)=>b.at.localeCompare(a.at));
    body=`<div class="chips" style="margin-bottom:12px"><button class="chip ${!S.person?'on':''}" data-act="person" data-v="">Everyone</button>${names.map(n=>`<button class="chip ${S.person===n?'on':''}" data-act="person" data-v="${esc(n)}">${esc(n.split(' ')[0])}</button>`).join('')}</div>
    <div class="log">${list.slice(0,300).map(e=>logRow(e)).join('')||'<div class="empty">No entries yet.</div>'}</div>${list.length>300?'<p class="small muted">Showing the latest 300. Export the count log for everything.</p>':''}`;
  }else if(S.tab==='export'){
    const st=S.settings;
    body=`<div class="stack"><div class="panel stack"><h2>Innergy upload file</h2>
    <p class="small muted" style="margin:0">One row per counted item, in the Innergy Inventory Balance template. Location: ${esc(st.facility)} / ${esc(st.warehouse)} / ${esc(st.bin)}.</p>
    <label class="check"><input type="checkbox" id="zeroes" ${S.zeroes?'checked':''} data-act="zeroes"><span>Also set the ${stocked.length-stockedDone} uncounted stocked items to 0</span></label>
    <button class="btn primary big" data-act="exportInnergy">Download Innergy file (.xlsx)</button></div>
    <div class="panel stack"><h2>Count log</h2><p class="small muted" style="margin:0">Every entry with who, when, how it was counted, and every fix or void.</p>
    <button class="btn ghost" data-act="exportLog">Download count log (.xlsx)</button></div>
    ${!S.dl?'<p class="small muted">Downloads aren’t available in this view.</p>':''}</div>`;
  }
  return head+body;
}
function logRow(e){
  const it=S.materials[e.sku]||{name:e.sku,uom:e.uom};
  const trail=(e.edits||[]).map(x=>`${tm(x.at)} ${x.byName}: ${x.type==='void'?'voided':fmt(x.from)+' → '+fmt(x.to)}${x.reason?' ('+x.reason+')':''}`).join(' · ');
  return `<button class="lg ${e.voided?'void':''}" data-act="mgritem" data-sku="${esc(e.sku)}"><div class="top"><span>${esc(splitName(it.name).name)}</span><span class="q">${esc(fmt(e.qty))} ${esc(e.uom||it.uom)}</span></div>
  <div class="small muted">${esc(e.byName)} · ${esc(tm(e.at))} · ${esc(e.detail||'')}</div>${e.voided?'<span class="flag bad">Voided</span>':''}${trail?`<div class="trail">${esc(trail)}</div>`:''}</button>`;
}
function vMgrItem(){
  const it=S.materials[S.mgrSku];if(!it){S.view='review';return vReview()}
  const m=S.rMonth;const src=(m===S.entMonth)?S.entries:(S.rEntries||{});
  const ents=Object.values(src).filter(e=>e.sku===it.id).sort((a,b)=>a.at.localeCompare(b.at));
  const tot=r5(ents.filter(e=>!e.voided).reduce((s,e)=>s+(+e.qty||0),0));
  const ee=S.editEntry;
  return `${bar('Check item','review')}<div class="stack"><div><h1 style="font-size:1.3rem">${esc(splitName(it.name).name)}</h1><div class="small muted">${esc(it.id)} · ${esc(it.uom)} · Innergy shows ${esc(fmt(it.onHand))}</div></div>
  <div class="kpis"><div class="kpi"><span class="label">Counted</span><b>${esc(fmt(tot))}</b></div><div class="kpi"><span class="label">Innergy</span><b>${esc(fmt(it.onHand))}</b></div><div class="kpi"><span class="label">Change</span><b>${esc((tot-it.onHand>0?'+':'')+fmt(r5(tot-it.onHand)).replace(/^-?/,tot-it.onHand<0?'−':''))}</b></div></div>
  <h2>Entries</h2><div class="log">${ents.map(e=>`<div class="lg ${e.voided?'void':''}"><div class="top"><span>${esc(e.byName)}</span><span class="q">${esc(fmt(e.qty))}</span></div>
    <div class="small muted">${esc(tm(e.at))} · ${esc(e.detail||'')}</div>${(e.edits||[]).length?`<div class="trail">${esc(e.edits.map(x=>`${tm(x.at)} ${x.byName}: ${x.type==='void'?'voided':fmt(x.from)+' → '+fmt(x.to)}${x.reason?' ('+x.reason+')':''}`).join(' · '))}</div>`:''}
    ${!e.voided&&S.months[m]?.status==='open'?(ee===e._id?`<div class="stack" style="margin-top:8px"><div class="mini"><div class="field"><label for="eq">Correct quantity</label><input id="eq" class="inp" inputmode="decimal" value="${esc(e.qty)}"></div></div>
      <div class="field"><label for="er">Reason</label><input id="er" class="inp" style="font-size:1rem;font-weight:500" placeholder="Example: counted pieces, not pairs"></div>
      <div class="row"><button class="btn small primary" data-act="mgrSave" data-id="${esc(e._id)}">Save fix</button><button class="btn small danger" data-act="mgrVoid" data-id="${esc(e._id)}">Void entry</button><button class="btn small ghost" data-act="mgrCancel">Cancel</button></div></div>`
      :`<div class="row" style="margin-top:6px"><button class="btn small ghost" data-act="mgrEdit" data-id="${esc(e._id)}">Fix or void</button></div>`):''}</div>`).join('')||'<div class="empty">No one has counted this item.</div>'}</div>
  <h2>Item setup</h2><div class="panel stack">
  <div class="field"><label for="ia">Area in the app</label><select id="ia" class="inp">${AREAS.map(a=>`<option value="${a.k}" ${(it.area||'other')===a.k?'selected':''}>${esc(a.name)}</option>`).join('')}</select></div>
  <div class="field"><label for="ih">Extra counting tip for this item</label><input id="ih" class="inp" style="font-size:1rem;font-weight:500" value="${esc(it.howTo||'')}" placeholder="Example: stored upstairs above the paint booth"></div>
  <label class="check"><input type="checkbox" id="is" ${it.stocked?'checked':''}><span>Show in the main list (usually stocked)</span></label>
  <button class="btn primary" data-act="saveItem">Save item setup</button></div></div>`;
}

function vWho(){
  const ppl=S.people.filter(p=>p.active!==false).sort((a,b)=>a.name.localeCompare(b.name));
  return `<div class="brand"><div class="label">Swan Creek Cabinet Co.</div><div class="mark">Monthly <em>Inventory</em> Count</div></div>
  <div class="stack"><h2>Who’s counting?</h2><p class="muted" style="margin:0">Tap your name.</p>
  ${ppl.length?`<div class="names">${ppl.map(p=>`<button class="name" data-act="pick" data-id="${esc(p.id)}"><span class="av">${esc(initials(p.name))}</span><span>${esc(p.name)}</span></button>`).join('')}</div>`
  :`<div class="panel empty">No one is set up yet. Add names to the People tab of the Google Sheet.</div>`}</div>`;
}
function vPin(){
  const p=S.people.find(x=>x.id===S.pick);if(!p){S.view='who';return vWho()}
  const setting=!p.hasPin;const confirm=setting&&S.pin1!==null;
  const head=setting?(confirm?'Type the same PIN again':'Make your 4-number PIN'):'Type your PIN';
  return `<div class="bar"><button class="back" data-act="go" data-v="who">${ICON_BACK}Back</button><div class="t"></div></div><div class="stack" style="text-align:center;align-items:center">
  <span class="av" style="width:64px;height:64px;border-radius:50%;background:var(--gold-tint);display:grid;place-items:center;font-weight:800;font-size:1.3rem">${esc(initials(p.name))}</span>
  <h1>${esc(p.name)}</h1><p style="margin:0;font-weight:700">${head}</p>
  ${setting&&!confirm?'<p class="muted small" style="margin:0">Pick 4 numbers you’ll remember. You’ll use them every month.</p>':''}</div>
  <div id="dots" class="dots">${[0,1,2,3].map(i=>`<span class="dot${S.pin.length>i?' on':''}"></span>`).join('')}</div>
  <div class="msg ${S.pinMsg?'bad':''}">${esc(S.pinMsg)}</div>
  <div class="pad">${[1,2,3,4,5,6,7,8,9].map(n=>`<button class="key" data-act="key" data-k="${n}" aria-label="${n}">${n}</button>`).join('')}
  <button class="key alt" data-act="go" data-v="who">Not me</button><button class="key" data-act="key" data-k="0">0</button><button class="key alt" data-act="key" data-k="del">Erase</button></div>`;
}
function vAdmin(){
  const mats=Object.values(S.materials);const ppl=(S.allPeople||[]).slice().sort((a,b)=>a.name.localeCompare(b.name));
  return `<div class="stack">
  <h2>People</h2><div class="log">${ppl.map(p=>`<div class="lg"><div class="top"><span>${esc(p.name)}${p.active===false?' <span class="flag bad">Off</span>':''}</span><span class="flag ${p.role==='manager'?'warn':'ok'}">${p.role==='manager'?'Manager':'Counter'}</span></div>
    <div class="row"><button class="btn small ghost" data-act="pOp" data-op="role" data-id="${esc(p.id)}">${p.role==='manager'?'Make counter':'Make manager'}</button><button class="btn small ghost" data-act="pOp" data-op="resetPin" data-id="${esc(p.id)}" ${p.hasPin?'':'disabled'}>${p.hasPin?'Reset PIN':'No PIN yet'}</button><button class="btn small ghost" data-act="pOp" data-op="active" data-id="${esc(p.id)}">${p.active===false?'Turn on':'Turn off'}</button></div></div>`).join('')}</div>
  <div class="row"><input id="newp" class="inp grow" style="font-size:1rem" placeholder="New person’s full name"><button class="btn small primary" data-act="addPerson">Add</button></div>

  <h2 style="margin-top:12px">Materials from Innergy</h2>
  <div class="panel stack"><p class="small" style="margin:0">${mats.length} materials loaded · ${mats.filter(m=>m.stocked).length} in stock. Upload a fresh Innergy export whenever materials are added. Nothing in Innergy changes.</p>
  <div class="field"><label for="fLib">1. Material Library export (adds new materials)</label><div class="small muted">Any Excel list with Name and SKU columns works. Category, Default UoM and Cost are used if present.</div><input id="fLib" type="file" accept=".xlsx,.xls,.csv" data-act="fileLib"></div>
  <div class="field"><label for="fMst">2. Master Inventory export (updates last count, units and cost)</label><input id="fMst" type="file" accept=".xlsx,.xls,.csv" data-act="fileMst"></div>
  <div id="impmsg" class="small" aria-live="polite">${esc(S.impMsg||'')}</div></div>

  <h2 style="margin-top:12px">How-to-count cards</h2>
  <p class="small muted" style="margin:0">One tip per line. Counters see these at the top of each area.</p>
  ${AREAS.map(a=>`<div class="field"><label for="g-${a.k}">${esc(a.name)}</label><textarea id="g-${a.k}" class="inp">${esc(((S.guides[a.k])||a.guide).join('\n'))}</textarea></div>`).join('')}
  <button class="btn primary" data-act="saveGuides">Save how-to cards</button>

  <h2 style="margin-top:12px">Innergy location</h2>
  <div class="panel stack">${['facility','warehouse','bin'].map(k=>`<div class="field"><label for="s-${k}">${k[0].toUpperCase()+k.slice(1)}</label><input id="s-${k}" class="inp" style="font-size:1rem" value="${esc(S.settings[k])}"></div>`).join('')}
  <button class="btn primary" data-act="saveSettings">Save location</button></div></div>`;
}

/* ---------- render ---------- */
function render(){
  if(!S.ready)return;
  if(!S.me&&!['who','pin'].includes(S.view))S.view='who';
  const v={who:vWho,pin:vPin,home:vHome,area:vArea,search:vSearch,item:vItem,note:vNote,review:vReview,mgritem:vMgrItem}[S.view]||vWho;
  app.innerHTML=(DEMO?'<div class="demo-banner">Demo mode · saved on this device only</div>':'')+'<div id="pend" class="demo-banner bad" hidden></div>'+v();
  pendingBadge();
}
function go(v){S.view=v;if(v!=='item'){S.draft=null;S.mode='new';S.editId=null}render();scrollTo(0,0)}

/* ---------- actions ---------- */
async function loadMonth(m){S.busy='loading';try{const ents=await call('monthEntries',{month:m});const o={};ents.forEach(e=>o[e._id]=e);S.rEntries=o}catch(e){toast('Couldn’t load that month. Check the connection.',true)}S.busy='';render()}
async function pinKey(k){
  const p=S.people.find(x=>x.id===S.pick);if(!p||S.busy==='pin')return;
  if(k==='del'){S.pin=S.pin.slice(0,-1);S.pinMsg='';render();return}
  if(S.pin.length>=4)return;S.pin+=k;S.pinMsg='';render();
  if(S.pin.length<4)return;
  const pin=S.pin;
  if(!p.hasPin&&S.pin1===null){S.pin1=pin;S.pin='';setTimeout(render,150);return}
  if(!p.hasPin&&S.pin1!==pin){S.pin1=null;S.pin='';S.pinMsg='Those didn’t match. Start again.';render();$('#dots')?.classList.add('shake');return}
  S.busy='pin';S.pinMsg='Checking…';render();
  try{const r=await call(p.hasPin?'login':'setPin',{id:p.id,pin});S.busy='';S.token=r.token;S.me=r.me;LS.set('scSession',{token:r.token,me:r.me});
    if(!p.hasPin)toast('PIN saved. Remember it for next month.');
    S.pin='';S.pin1=null;S.pinMsg='';await boot();}
  catch(e){S.busy='';S.pin='';S.pin1=null;S.pinMsg=e instanceof NetErr?'No connection. Move to a spot with signal and try again.':e.message;
    if(e.code==='nopin'){p.hasPin=false}render();$('#dots')?.classList.add('shake')}
}
function saveEntry(zero){
  const it=S.materials[S.sku];const M=methodOf(it);const m=openMonth();
  if(!m){toast('The count is closed. Ask your manager.',true);return}
  const c=zero?{qty:0,detail:'None found'}:compute(M,S.draft);
  if(S.mode==='fix'&&S.editId){const e=S.entries[S.editId];
    const editId=uid('x');
    e.edits=[...(e.edits||[]),{type:'fix',at:nowISO(),by:S.me.id,byName:meName(),from:e.qty,to:c.qty,reason:'Fixed by counter'}];e.qty=c.qty;e.detail=c.detail;
    enqueue('editEntry',{id:e._id,editId,type:'fix',qty:c.qty,detail:c.detail,reason:'Fixed by counter'});toast('Fixed ✓');
  }else{
    const e={id:uid('e'),month:m,sku:it.id,qty:c.qty,detail:c.detail,method:M.k,uom:it.uom,area:it.area||'other',at:nowISO()};
    S.entries[e.id]={...e,_id:e.id,by:S.me.id,byName:meName(),voided:false,edits:[],pending:true};
    enqueue('addEntry',{entry:e});toast('Saved ✓ '+fmt(c.qty)+' '+M.unit);
  }
  S.draft=null;S.mode='new';S.editId=null;S.view=S.from==='search'?'search':'area';render();
  const el=document.querySelector(`[data-sku="${CSS.escape(it.id)}"]`);el&&el.scrollIntoView({block:'center'});
}
function updateTotal(){
  const it=S.materials[S.sku];if(!it||!S.draft)return;const M=methodOf(it);const c=compute(M,S.draft);
  const t=$('#tot');if(t)t.firstChild.nodeValue=fmt(c.qty)+' ';const d=$('#det');if(d)d.textContent=c.detail;const b=$('#savebtn');if(b)b.disabled=!(c.qty>0);
}
async function mgrWrite(fn,ok){try{await fn();toast(ok);render()}catch(e){console.warn(e);toast(e instanceof NetErr?'No connection. Try again when you have signal.':'Couldn’t save: '+e.message,true)}}

/* ---------- imports ---------- */
function readBook(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>{try{const wb=XLSX.read(new Uint8Array(r.result),{type:'array'});res(XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{header:1,defval:null}))}catch(e){rej(e)}};r.onerror=rej;r.readAsArrayBuffer(file)})}
function findHeader(rows,need){for(let i=0;i<Math.min(rows.length,15);i++){const h=(rows[i]||[]).map(x=>String(x??'').trim().toLowerCase());if(need.every(n=>h.includes(n)))return{i,h}}return null}
function areaOfCat(c){c=c||'';for(const[k,a]of[['Sheetgoods','sheet'],['Sheet','sheet'],['Hardwood','hardwood'],['Millwork','millwork'],['Edge','edge'],['Hardware','hardware'],['Accessories','accessories'],['Finishing','finishing'],['Production Consumables','supplies'],['Consumables','supplies']])if(c.includes(k))return a;return'other'}
function impMsg(t){S.impMsg=t;const el=$('#impmsg');if(el)el.textContent=t}
async function writeMaterials(ops,label){
  impMsg(label+'…');
  const r=await call('saveMaterials',{ops:ops.map(([sku,op,data])=>({sku,data}))});
  S.materials={};r.materials.forEach(m=>S.materials[m.id]=m);
  return r;
}
async function importLib(file){
  impMsg('Reading file…');
  try{const rows=await readBook(file);const H=findHeader(rows,['name','sku']);if(!H){impMsg('That file needs a Name column and a SKU column. Check the header row and try again.');return}
    const ci=n=>H.h.indexOf(n);const iC=ci('category'),iN=ci('name'),iS=ci('sku'),iU=ci('default uom')>=0?ci('default uom'):ci('uom'),iK=ci('cost');
    let cur='';const ops=[];let added=0,changed=0;const seen=new Set();
    for(const r of rows.slice(H.i+1)){if(!r)continue;const sku=String(r[iS]??'').trim();
      if(iC>=0&&r[iC]&&!sku){cur=String(r[iC]);continue}if(!sku||seen.has(sku))continue;seen.add(sku);
      if(iC>=0&&r[iC])cur=String(r[iC]);
      const segs=cur.replace(/^Materials - Production - /,'').split(' - ');const sub=segs.length>1?segs[segs.length-1]:'';
      const name=String(r[iN]??'').trim();const ex=S.materials[sku];
      if(!ex){ops.push([sku,'set',{name,sub,area:areaOfCat(cur),uom:String((iU>=0&&r[iU])||'EA'),cost:+(iK>=0?r[iK]:0)||0,onHand:0,stocked:false,active:true,addedAt:nowISO()}]);added++}
      else if(ex.name!==name||(ex.sub||'')!==sub||(!ex.areaSet&&(ex.area||'other')!==areaOfCat(cur))){ops.push([sku,'update',{name,sub,...(ex.areaSet?{}:{area:areaOfCat(cur)})}]);changed++}}
    if(!ops.length){impMsg('Up to date. No new materials in that file.');return}
    await writeMaterials(ops,`Saving ${added} new and ${changed} renamed materials`);
    impMsg(`Done. ${added} new materials added, ${changed} updated. New items show under “not usually in stock” until a Master Inventory upload says otherwise.`);render();
  }catch(e){console.warn(e);impMsg('Couldn’t finish: '+(e.message||e))}
}
async function importMst(file){
  impMsg('Reading file…');
  try{const rows=await readBook(file);const H=findHeader(rows,['material sku']);if(!H){impMsg('That file doesn’t look like a Master Inventory export. It needs a Material SKU column.');return}
    const ci=(...ns)=>{for(const n of ns){const i=H.h.indexOf(n);if(i>=0)return i}return-1};
    const iS=ci('material sku'),iN=ci('name'),iU=ci('common uom','common uom name'),iK=ci('cost of base uom','cost per base uom'),iQ=ci('on hand total','quantity');
    const agg={};for(const r of rows.slice(H.i+1)){if(!r)continue;const s=String(r[iS]??'').trim();if(!s)continue;const a=agg[s]=agg[s]||{q:0,u:{},k:{},name:String(r[iN]??'')};a.q+=+r[iQ]||0;if(r[iU])a.u[r[iU]]=(a.u[r[iU]]||0)+1;if(r[iK])a.k[r[iK]]=(a.k[r[iK]]||0)+1}
    const top=o=>Object.entries(o).sort((a,b)=>b[1]-a[1])[0]?.[0];
    const ops=[];
    for(const[s,a]of Object.entries(agg)){const ex=S.materials[s];const q=r5(a.q);const u=top(a.u);const k=top(a.k);
      if(!ex){ops.push([s,'set',{name:a.name.trim(),sub:'',area:'other',uom:u||'EA',cost:+k||0,onHand:q,stocked:q>0,active:true,addedAt:nowISO()}]);continue}
      const d={};if(r5(+ex.onHand||0)!==q)d.onHand=q;if(!ex.stockSet&&!!ex.stocked!==(q>0))d.stocked=q>0;if(u&&u!==ex.uom)d.uom=u;if(k&&+k!==+ex.cost)d.cost=+k;
      if(Object.keys(d).length)ops.push([s,'update',d])}
    for(const ex of Object.values(S.materials))if(!agg[ex.id]&&(+ex.onHand||0)!==0)ops.push([ex.id,'update',{onHand:0,...(ex.stockSet?{}:{stocked:false})}]);
    if(!ops.length){impMsg('Up to date. Nothing changed.');return}
    await writeMaterials(ops,`Updating ${ops.length} materials`);impMsg(`Done. ${ops.length} materials updated from Master Inventory.`);render();
  }catch(e){console.warn(e);impMsg('Couldn’t finish: '+(e.message||e))}
}

/* ---------- exports ---------- */
function save(filename,aoa,sheet,widths){
  const ws=XLSX.utils.aoa_to_sheet(aoa);if(widths)ws['!cols']=widths.map(w=>({wch:w}));const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,sheet);
  XLSX.writeFile(wb,filename);
}
function exportInnergy(){
  if(Q.length){toast('Wait until all counts are sent ('+Q.length+' still on this phone).',true);return}
  const m=S.rMonth;const src=(m===S.entMonth)?S.entries:(S.rEntries||{});const t=totals(src);const st=S.settings;
  const rows=[['Material SKU','Common UoM Name','Cost per Base UoM','Quantity','Facility','Warehouse','Bin','Proj No.','Work Order No.']];
  const skus=Object.keys(t);
  if(S.zeroes)Object.values(S.materials).forEach(i=>{if(i.stocked&&i.active!==false&&!t[i.id])skus.push(i.id)});
  skus.sort().forEach(s=>{const it=S.materials[s]||{uom:'EA',cost:0};rows.push([s,it.uom,+it.cost||0,t[s]?t[s].q:0,st.facility,st.warehouse,st.bin,null,null])});
  buildInnergyFile(rows.slice(1)).then(blob=>downloadBlob(blob,`Innergy Inventory Balance ${m}.xlsx`)).catch(e=>{console.warn(e);toast('Couldn’t build the Innergy file: '+e.message,true)});
}

/* Fill Innergy's own template so every style, border, column width and the Instructions tab stay exactly as Innergy made them. */
const xesc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const xunesc=s=>String(s).replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&apos;/g,"'").replace(/&amp;/g,'&');
async function buildInnergyFile(rows){
  const zip=await JSZip.loadAsync(INNERGY_TEMPLATE,{base64:true});
  const sstPath='xl/sharedStrings.xml',shPath='xl/worksheets/sheet2.xml';
  let sst=await zip.file(sstPath).async('string');
  const items=[...sst.matchAll(/<si>([\s\S]*?)<\/si>/g)].map(x=>x[1]);
  const idx={};items.forEach((x,i)=>{const t=x.match(/^<t(?: [^>]*)?>([\s\S]*)<\/t>$/);if(t&&idx[xunesc(t[1])]===undefined)idx[xunesc(t[1])]=i});
  let uniq=items.length,refs=0;const added=[];
  const sid=v=>{refs++;v=String(v);if(idx[v]===undefined){idx[v]=uniq++;added.push('<si><t xml:space="preserve">'+xesc(v)+'</t></si>')}return idx[v]};
  let sh=await zip.file(shPath).async('string');
  const row1=sh.match(/<row r="1"[\s\S]*?<\/row>/)[0];
  const cols='ABCDEFGHI';
  const txt=(c,r,v)=>v===null||v===undefined||v===''?'':`<c r="${c}${r}" s="5" t="s"><v>${sid(v)}</v></c>`;
  let body=row1,r=1;
  for(const x of rows){
    r++;
    body+=`<row r="${r}" spans="1:9" x14ac:dyDescent="0.25">`+txt('A',r,x[0])+txt('B',r,x[1])+`<c r="C${r}" s="1"><v>${+x[2]||0}</v></c>`+`<c r="D${r}" s="24"><v>${+x[3]||0}</v></c>`
      +txt('E',r,x[4])+txt('F',r,x[5])+txt('G',r,x[6])+txt('H',r,x[7])+txt('I',r,x[8])+'</row>';
  }
  const last=Math.max(1000,r);
  for(let k=r+1;k<=last;k++)body+=k<=16?`<row r="${k}" spans="1:9" x14ac:dyDescent="0.25"/>`:`<row r="${k}" x14ac:dyDescent="0.25"/>`;
  sh=sh.replace(/<sheetData>[\s\S]*<\/sheetData>/,'<sheetData>'+body+'</sheetData>').replace(/<dimension ref="[^"]*"\/>/,`<dimension ref="A1:I${last}"/>`);
  sst=sst.replace(/<sst([^>]*?)count="\d+"([^>]*?)uniqueCount="\d+"/,(m0,a,b)=>`<sst${a}count="${items.length+refs}"${b}uniqueCount="${uniq}"`).replace('</sst>',added.join('')+'</sst>');
  zip.file(shPath,sh);zip.file(sstPath,sst);
  return zip.generateAsync({type:'blob',compression:'DEFLATE',mimeType:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
}
function downloadBlob(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},2000)}
const INNERGY_TEMPLATE="";
function exportLog(){
  const m=S.rMonth;const src=(m===S.entMonth)?S.entries:(S.rEntries||{});
  const rows=[['Month','Counted at','Person','Material SKU','Item','Area','Unit','Quantity','How it was counted','Status','Changes']];
  Object.values(src).sort((a,b)=>a.at.localeCompare(b.at)).forEach(e=>{const it=S.materials[e.sku]||{name:e.sku};
    rows.push([m,new Date(e.at).toLocaleString('en-US'),e.byName,e.sku,it.name,AREA[e.area]?.name||'',e.uom||it.uom,e.qty,e.detail||'',e.voided?'Voided':'Active',
      (e.edits||[]).map(x=>`${new Date(x.at).toLocaleString('en-US')} ${x.byName}: ${x.type==='void'?'voided':x.from+' → '+x.to}${x.reason?' ('+x.reason+')':''}`).join(' | ')])});
  save(`Inventory Count Log ${m}.xlsx`,rows,'Count Log',[9,20,18,12,50,22,12,10,36,9,60]);
}

/* ---------- events ---------- */
app.addEventListener('click',async ev=>{
  const b=ev.target.closest('[data-act]');if(!b||b.tagName==='INPUT'&&b.type==='file')return;
  const a=b.dataset.act,d=S.draft;
  switch(a){
    case'pick':S.pick=b.dataset.id;S.pin='';S.pin1=null;S.pinMsg='';go('pin');break;
    case'key':pinKey(b.dataset.k);break;
    case'signout':signOut(false);break;
    case'go':{const v=b.dataset.v.trim();if(v==='who'){S.pick=null;S.pin='';S.pin1=null;S.pinMsg=''}if(v==='review'){S.rEntries=null;S.editEntry=null}go(v);break}
    case'area':S.area=b.dataset.k;S.showAll=false;S.from='area';go('area');break;
    case'showAll':S.showAll=!S.showAll;render();break;
    case'item':S.sku=b.dataset.sku;S.from=S.view==='search'?'search':'area';S.draft=null;S.mode='new';S.editId=null;
      {const it=S.materials[S.sku];if(it&&S.view==='search')S.area=it.area||'other'}go('item');break;
    case'fix':{const e=S.entries[b.dataset.id];if(!e)break;S.mode='fix';S.editId=e._id;S.draft=newDraft(S.materials[S.sku],methodOf(S.materials[S.sku]));render();scrollTo(0,0);break}
    case'step':{const f=b.dataset.f;const cur=num(d[f]);d[f]=String(Math.max(0,r5(cur+ +b.dataset.d)));const el=$('#'+f);if(el)el.value=d[f];updateTotal();break}
    case'part':d.parts.push(+b.dataset.p);render();break;
    case'unpart':d.parts.splice(+b.dataset.i,1);render();break;
    case'pmode':d.piecesMode=b.dataset.v==='1';render();break;
    case'bmode':d.mode=b.dataset.v;render();break;
    case'bt':d.t=+b.dataset.v;render();break;
    case'addrow':{const w=num(d.w),l=num(d.l),c=num(d.c)||1;if(!w||!l){toast('Enter the width and the length first.',true);break}d.rows.push({t:d.t,w,l,c});d.w='';d.l='';d.c='';render();break}
    case'll':d.l=+b.dataset.v;render();break;
    case'addlf':{const c=num(d.c);if(!c){toast('Enter how many sticks first.',true);break}d.rows.push({l:d.l,c});d.c='';render();break}
    case'unrow':d.rows.splice(+b.dataset.i,1);render();break;
    case'save':{const it=S.materials[S.sku];const M=methodOf(it);
      if(M.k==='bf'&&d.mode==='build'&&num(d.w)&&num(d.l)){d.rows.push({t:d.t,w:num(d.w),l:num(d.l),c:num(d.c)||1});d.w=d.l=d.c=''}
      if(M.k==='lf'&&num(d.c)){d.rows.push({l:d.l,c:num(d.c)});d.c=''}
      saveEntry(false);break}
    case'zero':saveEntry(true);break;
    case'sendNote':{const t=$('#note').value.trim();if(!t){toast('Type what you found first.',true);break}const m=openMonth();if(!m)break;
      const n={id:uid('n'),month:m,text:t};S.notes[n.id]={...n,_id:n.id,byName:meName(),at:nowISO()};enqueue('addNote',{note:n});toast('Sent to the manager ✓');go('home');break}
    case'startMonth':{const k=monthKey(new Date());await mgrWrite(async()=>{const ms=await call('setMonth',{month:k,status:'open'});S.months={};ms.forEach(m=>S.months[m.key]=m);S.entMonth=k;await refresh()},monthName(k)+' count started');S.rMonth=k;render();break}
    case'closeMonth':{if(b.dataset.sure!=='1'){b.dataset.sure='1';b.textContent='Tap again to close. Counters will be locked out.';break}
      if(Q.length){toast('Wait until all counts on this phone are sent.',true);break}
      await mgrWrite(async()=>{const ms=await call('setMonth',{month:S.rMonth,status:'closed'});S.months={};ms.forEach(m=>S.months[m.key]=m)},'Count closed');break}
    case'reopenMonth':await mgrWrite(async()=>{const ms=await call('setMonth',{month:S.rMonth,status:'open'});S.months={};ms.forEach(m=>S.months[m.key]=m);S.entMonth=S.rMonth;S.rEntries=null;await refresh()},'Reopened');break;
    case'tab':S.tab=b.dataset.v;render();break;
    case'person':S.person=b.dataset.v;render();break;
    case'zeroes':S.zeroes=b.checked;break;
    case'mgritem':S.mgrSku=b.dataset.sku;S.editEntry=null;go('mgritem');break;
    case'mgrEdit':S.editEntry=b.dataset.id;render();break;
    case'mgrCancel':S.editEntry=null;render();break;
    case'mgrSave':case'mgrVoid':{const m=S.rMonth;const id=b.dataset.id;const src=(m===S.entMonth)?S.entries:S.rEntries;const reason=$('#er').value.trim();
      if(!reason){toast('Add a short reason so the log makes sense later.',true);break}
      S.editEntry=null;await mgrWrite(async()=>{const r=await call('editEntry',{id,type:a==='mgrVoid'?'void':'fix',qty:num($('#eq')?.value),reason});src[id]=r},a==='mgrVoid'?'Entry voided':'Fixed ✓');break}
    case'saveItem':{const it=S.materials[S.mgrSku];const area=$('#ia').value,howTo=$('#ih').value.trim(),stocked=$('#is').checked;
      const p={area,howTo,stocked,areaSet:area!==it.area||!!it.areaSet,stockSet:stocked!==!!it.stocked||!!it.stockSet};
      await mgrWrite(async()=>{await call('saveMaterials',{ops:[{sku:it.id,data:p}]});Object.assign(it,p)},'Item saved');break}
    case'pOp':{if(b.dataset.op==='resetPin'&&b.dataset.sure!=='1'){b.dataset.sure='1';b.textContent='Tap again to reset';break}
      await mgrWrite(async()=>{S.allPeople=await call('person',{op:b.dataset.op,id:b.dataset.id})},'Updated');break}
    case'addPerson':{const n=$('#newp').value.trim();await mgrWrite(async()=>{S.allPeople=await call('person',{op:'add',name:n})},n+' added');break}
    case'saveGuides':{const g={};for(const ar of AREAS){g[ar.k]=$('#g-'+ar.k).value.split('\n').map(x=>x.trim()).filter(Boolean)}
      await mgrWrite(async()=>{await call('setSetting',{key:'guides',value:g});S.guides=g},'How-to cards saved');break}
    case'saveSettings':{const o={};['facility','warehouse','bin'].forEach(k=>o[k]=$('#s-'+k).value.trim());await mgrWrite(async()=>{await call('setSetting',{key:'location',value:o});S.settings={...S.settings,...o}},'Location saved');break}
    case'exportInnergy':exportInnergy();break;
    case'exportLog':exportLog();break;
  }
});
app.addEventListener('input',ev=>{
  const el=ev.target;
  if(el.dataset.f&&S.draft){S.draft[el.dataset.f]=el.value;updateTotal();return}
  if(el.dataset.in==='q'){S.q=el.value;
    if(S.view==='home'&&S.q.trim()){go('search');const i=$('#q2');if(i){i.focus();i.setSelectionRange(i.value.length,i.value.length)}}
    else if(S.view==='search'){const t=totals();const res=sortItems(Object.values(S.materials).filter(m=>m.active!==false&&matches(m,S.q))).slice(0,60);
      $('#sres').innerHTML=res.length?groupedList(res,t):'<div class="panel empty">No match. Try fewer words, or tell the manager it’s missing.</div>'}}
});
app.addEventListener('change',ev=>{
  const el=ev.target;
  if(el.dataset.in==='rm'){S.rMonth=el.value;S.rEntries=null;render()}
  if((el.dataset.act==='fileLib'||el.dataset.act==='fileMst')&&el.files[0]){
    if(S.importing){toast('Wait for the first upload to finish, then try again.',true);el.value='';return}
    S.importing=true;document.querySelectorAll('#fLib,#fMst').forEach(i=>i.disabled=true);
    (el.dataset.act==='fileLib'?importLib:importMst)(el.files[0]).finally(()=>{S.importing=false;document.querySelectorAll('#fLib,#fMst').forEach(i=>i.disabled=false)});
  }
});
addEventListener('keydown',ev=>{if(S.view==='pin'&&/^[0-9]$/.test(ev.key))pinKey(ev.key);if(S.view==='pin'&&ev.key==='Backspace')pinKey('del')});
if(DEMO&&!window.demoServer){app.innerHTML=loadingHTML('')+'<div class="panel"><b>The app isn’t connected yet.</b> Paste the Apps Script web app URL into CONFIG.scriptUrl in index.html.</div>'}
else boot();

</script>
</body>
</html>
